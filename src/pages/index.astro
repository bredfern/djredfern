---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>🤘 Hail</h1>
			<p>
      Welcome to my official home. I'm DJ Redfern, a guitarist, poet and techno dj and producer. I have performed many shows large and small over the last 34 years. I also produce elecro acoustic music with synthesized audio environments.
			</p>
			<p>
				I specialize in bringing contant creativity to the table, using devices, instruments, samples and software to bring in grooves you love with sounds you never heard before.
			</p>
		</main>
		<Footer />
	</body>
</html>
